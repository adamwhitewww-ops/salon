---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = ['Összes', 'Hajvágás', 'Szakáll', 'Szalon'];

const images = [
  { src: 'https://images.unsplash.com/photo-1605497788044-5a32c7078486?w=800&q=80', alt: 'Modern fade hajvágás', category: 'Hajvágás' },
  { src: 'https://images.unsplash.com/photo-1599351431202-1e0f0137899a?w=800&q=80', alt: 'Klasszikus hajvágás', category: 'Hajvágás' },
  { src: 'https://images.unsplash.com/photo-1621605815971-fbc98d665033?w=800&q=80', alt: 'Szakállformázás', category: 'Szakáll' },
  { src: 'https://images.unsplash.com/photo-1585747860019-8e8ef2a0ea91?w=800&q=80', alt: 'Szalon belső tere', category: 'Szalon' },
  { src: 'https://images.unsplash.com/photo-1622286342621-4bd786c2447c?w=800&q=80', alt: 'Borotválás', category: 'Szakáll' },
  { src: 'https://images.unsplash.com/photo-1596728325488-58c87691e9af?w=800&q=80', alt: 'Fiatalos frizura', category: 'Hajvágás' },
  { src: 'https://images.unsplash.com/photo-1634480015438-542af8ba7024?w=800&q=80', alt: 'Szakállgondozás', category: 'Szakáll' },
  { src: 'https://images.unsplash.com/photo-1493256338651-d82f7acb2b38?w=800&q=80', alt: 'Szalon hangulat', category: 'Szalon' },
  { src: 'https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=800&q=80', alt: 'Borbély munka közben', category: 'Hajvágás' },
  { src: 'https://images.unsplash.com/photo-1521490683712-35a1cb235d1c?w=800&q=80', alt: 'Borbélyszék', category: 'Szalon' },
  { src: 'https://images.unsplash.com/photo-1562004760-aceed7bb0fe3?w=800&q=80', alt: 'Pomádé és termékek', category: 'Szalon' },
  { src: 'https://images.unsplash.com/photo-1587909209111-5097ee578ec3?w=800&q=80', alt: 'Hajvágás közelről', category: 'Hajvágás' },
];
---

<BaseLayout
  title="Galéria"
  description="Tekintse meg borbélyaink legjobb munkáit, szalonunk hangulatát és a prémium szolgáltatásainkat bemutató képeinket."
>
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="page-hero__bg">
      <img src="https://images.unsplash.com/photo-1493256338651-d82f7acb2b38?w=1920&q=80" alt="Szalon" loading="eager" />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content">
      <span class="section-header__label">Munkáink</span>
      <h1>Galéria</h1>
      <p>Inspiráló képek szalonunkból és borbélyaink munkáiból</p>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section">
    <div class="container">
      <!-- Filter -->
      <div class="gallery-filters" id="gallery-filters">
        {categories.map((cat) => (
          <button
            class:list={['gallery-filter', { 'gallery-filter--active': cat === 'Összes' }]}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div class="gallery-grid" id="gallery-grid">
        {images.map((img, i) => (
          <div class="gallery-item" data-category={img.category}>
            <img src={img.src} alt={img.alt} loading={i < 4 ? 'eager' : 'lazy'} />
            <div class="gallery-item__overlay">
              <span>{img.alt}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark" style="text-align: center;">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">Tetszik amit lát?</span>
        <h2 class="section-header__title">Legyen Ön a következő!</h2>
        <p class="section-header__desc">
          Foglaljon időpontot és tapasztalja meg a SALON minőségét.
        </p>
      </div>
      <a href="/kapcsolat#idopontfoglalas" class="btn btn--primary">Időpontfoglalás</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    height: 50vh;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
  }

  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 15, 26, 0.75);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
  }

  .page-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .page-hero__content p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
  }

  /* FILTERS */
  .gallery-filters {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .gallery-filter {
    padding: 10px 24px;
    border: 2px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-light);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .gallery-filter:hover {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }

  .gallery-filter--active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  /* GRID */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .gallery-item {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4/3;
    cursor: pointer;
    transition: opacity var(--transition-base);
  }

  .gallery-item.hidden {
    display: none;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery-item:hover img {
    transform: scale(1.08);
  }

  .gallery-item__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 15, 26, 0.8) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    padding: 24px;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .gallery-item:hover .gallery-item__overlay {
    opacity: 1;
  }

  .gallery-item__overlay span {
    color: var(--color-white);
    font-weight: 500;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filters = document.querySelectorAll('.gallery-filter');
  const items = document.querySelectorAll('.gallery-item');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((f) => f.classList.remove('gallery-filter--active'));
      btn.classList.add('gallery-filter--active');

      const category = btn.getAttribute('data-category');

      items.forEach((item) => {
        if (category === 'Összes' || item.getAttribute('data-category') === category) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });
</script>
