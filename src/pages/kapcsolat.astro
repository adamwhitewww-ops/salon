---
import BaseLayout from '../layouts/BaseLayout.astro';

const calcomUsername = import.meta.env.PUBLIC_CALCOM_USERNAME || 'your-calcom-username';
---

<BaseLayout
  title="Kapcsolat & Időpontfoglalás"
  description="Foglaljon időpontot online a SALON borbélyszalonba, vagy vegye fel velünk a kapcsolatot. Budapest, Fő utca 12."
>
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="page-hero__bg">
      <img src="https://images.unsplash.com/photo-1521490683712-35a1cb235d1c?w=1920&q=80" alt="Borbélyszék" loading="eager" />
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container page-hero__content">
      <span class="section-header__label">Lépjen velünk kapcsolatba</span>
      <h1>Kapcsolat</h1>
      <p>Foglaljon időpontot vagy írjon nekünk</p>
    </div>
  </section>

  <!-- BOOKING -->
  <section class="section" id="idopontfoglalas">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">Foglalás</span>
        <h2 class="section-header__title">Online Időpontfoglalás</h2>
        <p class="section-header__desc">
          Válassza ki a kívánt szolgáltatást és időpontot az alábbi naptárból.
          Egyszerű, gyors, és bármikor módosítható.
        </p>
      </div>

      <div class="booking-embed">
        <div class="booking-embed__wrapper" id="cal-embed">
          <!-- Cal.com embed -->
          <iframe
            src={`https://cal.com/${calcomUsername}?embed=true&theme=light`}
            width="100%"
            height="700"
            frameborder="0"
            loading="lazy"
            title="Időpontfoglalás - Cal.com"
            style="border: none; border-radius: var(--radius-lg);"
          ></iframe>
        </div>
        <p class="booking-embed__note">
          Az időpontfoglalás a Cal.com platformon keresztül történik. Foglalás után
          visszaigazoló e-mailt kap a megadott e-mail címre.
        </p>
      </div>
    </div>
  </section>

  <!-- CONTACT INFO + FORM -->
  <section class="section section--light">
    <div class="container contact-grid">
      <!-- Contact Info -->
      <div class="contact-info">
        <span class="section-header__label">Elérhetőség</span>
        <h2>Hogyan érhet el minket?</h2>

        <div class="contact-info__items">
          <div class="contact-info__item">
            <div class="contact-info__icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h4>Cím</h4>
              <p>1234 Budapest, Fő utca 12.</p>
              <p class="contact-info__sub">Bejárat az utca felől, emelet: földszint</p>
            </div>
          </div>

          <div class="contact-info__item">
            <div class="contact-info__icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            </div>
            <div>
              <h4>Telefon</h4>
              <p><a href="tel:+3612345678">+36 1 234 5678</a></p>
              <p class="contact-info__sub">Hívjon minket nyitvatartási időben</p>
            </div>
          </div>

          <div class="contact-info__item">
            <div class="contact-info__icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h4>E-mail</h4>
              <p><a href="mailto:info@salon-barber.hu">info@salon-barber.hu</a></p>
              <p class="contact-info__sub">24 órán belül válaszolunk</p>
            </div>
          </div>

          <div class="contact-info__item">
            <div class="contact-info__icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <h4>Nyitvatartás</h4>
              <p>Hétfő – Péntek: 9:00 – 20:00</p>
              <p>Szombat: 9:00 – 16:00</p>
              <p class="contact-info__sub">Vasárnap: Zárva</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-wrapper">
        <div class="contact-form-card">
          <h3>Írjon nekünk</h3>
          <p>Kérdése van? Küldjön üzenetet és hamarosan válaszolunk.</p>

          <form class="contact-form" id="contact-form" action="#" method="POST">
            <div class="contact-form__group">
              <label for="name">Név *</label>
              <input type="text" id="name" name="name" placeholder="Az Ön neve" required />
            </div>
            <div class="contact-form__group">
              <label for="email">E-mail *</label>
              <input type="email" id="email" name="email" placeholder="pelda@email.hu" required />
            </div>
            <div class="contact-form__group">
              <label for="phone">Telefon</label>
              <input type="tel" id="phone" name="phone" placeholder="+36 30 123 4567" />
            </div>
            <div class="contact-form__group">
              <label for="subject">Tárgy</label>
              <select id="subject" name="subject">
                <option value="">Válasszon...</option>
                <option value="foglalas">Időpontfoglalás</option>
                <option value="kerdes">Általános kérdés</option>
                <option value="visszajelzes">Visszajelzés</option>
                <option value="egyeb">Egyéb</option>
              </select>
            </div>
            <div class="contact-form__group contact-form__group--full">
              <label for="message">Üzenet *</label>
              <textarea id="message" name="message" rows="5" placeholder="Írja le kérdését vagy kérését..." required></textarea>
            </div>
            <div class="contact-form__group contact-form__group--full">
              <button type="submit" class="btn btn--primary" style="width: 100%;">Üzenet küldése</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- MAP -->
  <section class="map-full">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2695.7!2d19.0402!3d47.4979!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDfCsDI5JzUyLjQiTiAxOcKwMDInMjQuNyJF!5e0!3m2!1shu!2shu!4v1"
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="SALON Barber Shop helyszíne"
    ></iframe>
  </section>
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    height: 50vh;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
  }

  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 15, 26, 0.75);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
  }

  .page-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .page-hero__content p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
  }

  /* BOOKING */
  .booking-embed {
    max-width: 900px;
    margin: 0 auto;
  }

  .booking-embed__wrapper {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    padding: 8px;
  }

  .booking-embed__note {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin-top: 16px;
  }

  /* CONTACT GRID */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .contact-info h2 {
    margin-bottom: 32px;
  }

  .contact-info__items {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .contact-info__item {
    display: flex;
    gap: 16px;
  }

  .contact-info__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(201, 169, 110, 0.1), rgba(212, 175, 55, 0.1));
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  .contact-info__item h4 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .contact-info__item p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .contact-info__item a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .contact-info__item a:hover {
    color: var(--color-secondary);
  }

  .contact-info__sub {
    font-size: 0.8rem !important;
    color: var(--color-text-light) !important;
  }

  /* FORM */
  .contact-form-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: 40px;
    box-shadow: var(--shadow-md);
  }

  .contact-form-card h3 {
    margin-bottom: 8px;
  }

  .contact-form-card > p {
    font-size: 0.9rem;
    margin-bottom: 28px;
  }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .contact-form__group--full {
    grid-column: span 2;
  }

  .contact-form label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 6px;
    color: var(--color-text);
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text);
    transition: border-color var(--transition-fast);
    background: var(--color-gray-100);
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-secondary);
    background: var(--color-white);
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* MAP */
  .map-full {
    height: 450px;
  }

  .map-full iframe {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .contact-form {
      grid-template-columns: 1fr;
    }

    .contact-form__group--full {
      grid-column: span 1;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Köszönjük üzenetét! Hamarosan felvesszük Önnel a kapcsolatot.');
    form.reset();
  });
</script>
